{
  "manifest_version": 3,
  "name": "Luna · YouTube 英语助手",
  "version": "0.1.3",
  "description": "通过本机 Codex 和 ChatGPT 订阅，为 YouTube 英文字幕提供分级词语讲解。",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["nativeMessaging", "storage"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Luna 英语助手", "default_popup": "popup.html" },
  "content_scripts": [
    { "matches": ["https://www.youtube.com/*"], "js": ["page-bridge.js"], "world": "MAIN", "run_at": "document_start" },
    { "matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "web_accessible_resources": [
    { "resources": ["core.js", "panel.js", "panel.css"], "matches": ["https://www.youtube.com/*"] }
  ]
}
